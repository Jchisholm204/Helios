const dbank = "tr909"
const lbank = "mc303"
setCps(140/60/4)
// setCps(60/60/4)
// $: s("bd").struct("{1 0 0 1 0 1 0}%8").bank(dbank).scope()
$: s("hh!8").gain(.3).sometimesBy(.1, x=> x.ply(2))
$: s("hh!8").gain(.2)
$: s("bd(<7 6>, 16)").bank(dbank)
$: s("bd(<6 8>,16)").bank(lbank)
$: s("sd").bank(dbank).beat("<6 7>, <7 6>", 16)
$: s("<sawtooth>*8")
  .decay(0.08)
  .sustain(.02)
  .gain(1.5)
  ._scope()
